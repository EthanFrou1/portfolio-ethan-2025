# Cloudflare Turnstile
# Clé publique (safe à mettre dans le HTML frontend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# Clé secrète (UNIQUEMENT côté serveur / Vercel env vars — ne jamais committer)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# EmailJS (toutes les clés restent côté serveur)
EMAILJS_SERVICE_ID=service_22u3f7i
EMAILJS_TEMPLATE_ID=template_xvh42ag
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_here

# Si vous migrez vers Brevo à la place d'EmailJS :
# BREVO_API_KEY=your_brevo_api_key_here
